{
	email {$ACME_EMAIL}
	# Customers who point their own domain (crm.client.com) at this server get a certificate automatically,
	# but only for domains registered in Setu (the app answers /api/domain-check).
	on_demand_tls {
		ask http://app:8080/api/domain-check
	}
}

{$SETU_APP_HOST} {
	encode zstd gzip
	reverse_proxy app:8080
}

https:// {
	tls { on_demand }
	encode zstd gzip
	reverse_proxy app:8080
}
